# Base de données PostgreSQL
DATABASE_URL=postgresql://benitrack_user:secure_password_change_me@postgres:5432/benitrackpro
POSTGRES_USER=benitrack_user
POSTGRES_PASSWORD=secure_password_change_me
POSTGRES_DB=benitrackpro

# Redis
REDIS_URL=redis://redis:6379

# Backend
NODE_ENV=development
PORT=5000
JWT_SECRET=your_jwt_secret_key_change_me_in_production
JWT_EXPIRE=7d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_change_me
REFRESH_TOKEN_EXPIRE=30d

# API CORS
CORS_ORIGIN=http://localhost:3000

# Email (pour les notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@benitrackpro.com

# Maps & Géolocalisation
MAPBOX_TOKEN=your_mapbox_token_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# AWS (optionnel)
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=benitrackpro-bucket

# Sentry (pour le monitoring d'erreurs)
SENTRY_DSN=your_sentry_dsn_here

# Push Notifications (Firebase Cloud Messaging)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# Stripe (pour les paiements)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# Frontend Web
REACT_APP_API_URL=http://localhost:5000
REACT_APP_MAPBOX_TOKEN=your_mapbox_token_here
REACT_APP_ENVIRONMENT=development

# Logs
LOG_LEVEL=debug
LOG_FILE=./logs/app.log

# Session
SESSION_SECRET=your_session_secret_change_me
SESSION_TIMEOUT=3600

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100
